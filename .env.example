# ─────────────────────────────────────────────────────────────
# Mini-planet Voxel — variáveis de ambiente
# ─────────────────────────────────────────────────────────────

# Banco de dados — desenvolvimento local (sandbox)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ── Supabase (produção) ──────────────────────────────────────
# No dashboard do Supabase: botão "Connect" -> copie as duas URLs do pooler.
#
# 1) Transaction Pooler (porta 6543) -> runtime do app.
#    Configure como DATABASE_URL nas Environment Variables da VERCEL:
#    postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
#
# 2) Session Pooler (porta 5432) -> migrações de schema.
#    Configure como secret DATABASE_URL no GITHUB (Actions):
#    postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# ── Automação do GitHub (secrets deste ambiente de desenvolvimento) ──
# GITHUB_TOKEN="github_pat_..."   # fine-grained PAT com Contents: Read & Write no repo
# GITHUB_REPO="seu-usuario/mini-planet-voxel"
